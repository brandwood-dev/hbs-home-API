NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3001,http://localhost:5173
DOCS_ENABLED=true
API_PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_POOL_MAX=5
SUPABASE_URL=http://127.0.0.1:54321
# Server-only Supabase key for Admin invitations; never expose in the frontend.
SUPABASE_SECRET_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
# API-only secret key for image processing and Supabase Storage writes.
# Never expose this value in the frontend or commit it.
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=catalog-media
# Order email notifications use OVH SMTP and are disabled until credentials are configured.
ORDER_EMAIL_NOTIFICATIONS_ENABLED=false
# Required when notifications are enabled; set once to the deployment time to
# prevent historical outbox events from being sent as new-order notifications.
ORDER_EMAIL_ROLLOUT_AT=
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_USER=contact@hbs-home.com
SMTP_PASSWORD=
EMAIL_FROM=contact@hbs-home.com
ADMIN_APP_URL=http://localhost:5173
ORDER_EMAIL_POLL_INTERVAL_SECONDS=15
ORDER_EMAIL_MAX_ATTEMPTS=5
ORDER_EMAIL_BATCH_SIZE=10
# Operator-only: never configure these secrets in Render or in the frontend.
OPERATOR_DATABASE_URL=
HBS_API_DATABASE_PASSWORD=
ADMIN_EMAIL=
ADMIN_ROLE=super_admin
ADMIN_DISPLAY_NAME=
ADMIN_REDIRECT_URL=http://localhost:5173/admin/auth/callback
RELEASE_VERSION=0.5.0
GIT_SHA=local
BUILD_TIME=1970-01-01T00:00:00.000Z
